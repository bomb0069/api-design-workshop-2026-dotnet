{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "users-list": {
        "ClusterId": "users-cluster",
        "Match": {
          "Path": "/api/users"
        },
        "Metadata": {
          "AuthClass": "external",
          "RateLimitPolicy": "per-client"
        },
        "Transforms": [
          {
            "PathSet": "/users"
          }
        ]
      },
      "users-rest": {
        "ClusterId": "users-cluster",
        "Match": {
          "Path": "/api/users/{**rest}"
        },
        "Metadata": {
          "AuthClass": "external",
          "RateLimitPolicy": "per-client"
        },
        "Transforms": [
          {
            "PathPattern": "/users/{**rest}"
          }
        ]
      },
      "orders-list": {
        "ClusterId": "orders-cluster",
        "Match": {
          "Path": "/api/orders"
        },
        "Metadata": {
          "AuthClass": "external",
          "RateLimitPolicy": "global"
        },
        "Transforms": [
          {
            "PathSet": "/orders"
          }
        ]
      },
      "orders-rest": {
        "ClusterId": "orders-cluster",
        "Match": {
          "Path": "/api/orders/{**rest}"
        },
        "Metadata": {
          "AuthClass": "external",
          "RateLimitPolicy": "global"
        },
        "Transforms": [
          {
            "PathPattern": "/orders/{**rest}"
          }
        ]
      },
      "internal-users": {
        "ClusterId": "users-cluster",
        "Match": {
          "Path": "/internal/users/{**rest}"
        },
        "Metadata": {
          "AuthClass": "internal"
        },
        "Transforms": [
          {
            "PathPattern": "/users/{**rest}"
          }
        ]
      },
      "internal-orders": {
        "ClusterId": "orders-cluster",
        "Match": {
          "Path": "/internal/orders/{**rest}"
        },
        "Metadata": {
          "AuthClass": "internal",
          "RateLimitPolicy": "global"
        },
        "Transforms": [
          {
            "PathPattern": "/orders/{**rest}"
          }
        ]
      }
    },
    "Clusters": {
      "users-cluster": {
        "Destinations": {
          "users": {
            "Address": "http://users-service:8081/"
          }
        }
      },
      "orders-cluster": {
        "Destinations": {
          "orders": {
            "Address": "http://orders-service:8082/"
          }
        }
      }
    }
  }
}
